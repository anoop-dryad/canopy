# Copy to .envrc and fill in real values:  cp .envrc.example .envrc
# .envrc is gitignored — never commit the real one.

# ---------------------- App ----------------------------------

export ENV=development          # development | production
export APP_NAME=canopy
export APP_VERSION=dev

# ----------------------- HTTP ---------------------------------

export HTTP_ADDR=:8080

# ----------------------- Database ------------------------

export PGHOST=localhost
export PGPORT=5432
export PGUSER=postgres-user
export PGPASSWORD=postgres-password
export DB_NAME=db-name
export DB_APP_USER=db-user
export DB_APP_PASSWORD=db-password


# ----------------------- API KEY ------------------------
export CANOPY_API_KEY="api key"
